---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import FactBar from '../components/FactBar.astro';
import Figure from '../components/Figure.astro';
import ServiceList from '../components/ServiceList.astro';
import ContactCta from '../components/ContactCta.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import imgFahrzeug from '../assets/img/fahrzeug-header.jpg';
import imgBaustelle from '../assets/img/baustelle-erdtanks.jpg';
import imgSchlamm from '../assets/img/oelschlamm-tankboden.jpg';
import imgMonteur from '../assets/img/monteur-im-tank.jpg';
import imgDom from '../assets/img/domschacht-absaugung.jpg';
import imgSebastian from '../assets/img/sebastian-batho.jpg';
const featured = services[0];
const rest = services.slice(1);
const facts = [
  { label: 'Qualifikation', value: 'TÜV-geprüft', note: 'Qualifiziertes Unternehmen' },
  { label: 'Erfahrung', value: 'Seit vielen Jahren', note: 'Fachbetrieb für Behälterschutz' },
  { label: 'Standort', value: 'Ubstadt-Weiher', note: site.street },
  { label: 'Leistungen', value: `${services.length} Fachbereiche`, note: 'Von Reinigung bis Neuanlage' },
];
---
<Base title={site.name} description="Tank Service Batho aus Ubstadt-Weiher: qualifizierter, TÜV-geprüfter Fachbetrieb für Tankreinigung, Tankschutz, Demontage und Neutankanlagen. Telefon +49 7251 69686.">

  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="container container--wide hero__grid">
      <div class="hero__text">
        <span class="eyebrow reveal">Fachbetrieb für Tankschutz · Ubstadt-Weiher</span>
        <h1 id="hero-title" class="hero__title reveal" style="--d:90ms">Der kompetente Partner rund um Ihre Tankanlage.</h1>
        <p class="hero__lead reveal" style="--d:180ms">Qualifiziertes, TÜV-geprüftes Unternehmen mit langjähriger Erfahrung: Tankreinigung, Tankschutz, Demontage und Neutankanlagen aus einer Hand.</p>
        <div class="btn-row reveal" style="--d:270ms">
          <a href="/leistungen/" class="btn btn--light">Leistungen ansehen <Icon name="arrow" /></a>
          <a href={site.phoneHref} class="btn btn--outline-light"><Icon name="phone" /> {site.phone}</a>
        </div>
        <div class="hero__ruler reveal reveal--fade" style="--d:360ms" aria-hidden="true">
          <div class="ruler">{Array.from({ length: 31 }).map(() => <span></span>)}</div>
          <span class="hero__ruler-l mono">Tankreinigung · Beschichtungen · Anodenschutz · Innenhülle · Ölschäden · Stilllegung · Demontage · Neutankanlagen</span>
        </div>
      </div>

      <div class="hero__media reveal reveal--fade" style="--d:150ms">
        <div class="hero__frame">
          <Image src={imgFahrzeug} alt="Montagefahrzeug von Tank Service Batho mit TS-Emblem und Tankschutz-Anhänger" widths={[640, 940]} sizes="(min-width: 1024px) 55vw, 100vw" loading="eager" fetchpriority="high" />
          <span class="ticks" aria-hidden="true"></span>
          <span class="hero__mark hero__mark--t mono" aria-hidden="true">GGVS-Montage-LKW</span>
        </div>
        <div class="hero__sub">
          <div class="hero__frame hero__frame--2">
            <Image src={imgBaustelle} alt="Erdtanks in der Baugrube auf einer Baustelle" widths={[400, 800]} sizes="(min-width: 1024px) 33vw, 60vw" loading="eager" />
            <span class="ticks" aria-hidden="true"></span>
          </div>
          <div class="hero__spec">
            <span class="plaque__k">Im Einsatz</span>
            <span class="hero__spec-v">Fachbetrieb für Tankschutz, Ubstadt-Weiher</span>
            <dl class="hero__spec-dl">
              <div><dt>Anschrift</dt><dd>{site.street}</dd></div>
              <div><dt>Telefon</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd></div>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ VERTRAUENSLEISTE ============ -->
  <section class="trust" aria-label="Fakten zum Betrieb">
    <div class="container"><FactBar items={facts} /></div>
  </section>

  <!-- ============ LEISTUNGEN ============ -->
  <section class="section" id="leistungen" aria-labelledby="h-leistungen">
    <div class="container">
      <SectionHead num="01" eyebrow="Leistungen" title="Ein großes Leistungsspektrum. Aus einer Hand." lead="Bei der Planung, Installation und Modernisierung Ihrer Tankanlage unterstützen wir Sie gerne. Am Anfang steht immer die Besichtigung vor Ort und ein umfassendes Beratungsgespräch." />
      <div class="svc">
        <a href={`/leistungen/${featured.slug}/`} class="svc__feat reveal">
          <div class="svc__feat-img">
            <Image src={imgSchlamm} alt="Ölschlamm und Rückstände am Boden eines Heizöltanks" widths={[480, 800]} sizes="(min-width: 900px) 45vw, 100vw" />
            <span class="ticks" aria-hidden="true"></span>
          </div>
          <div class="svc__feat-body">
            <span class="num">{featured.index} · Kernleistung</span>
            <h3>{featured.title}</h3>
            <p>{featured.lead}</p>
            <ul class="svc__feat-facts">
              <li>Mündlicher Tankzustandsbericht vor Ort</li>
              <li>Zwischenlagerung bis 5.000 Liter Heizöl ohne Mehrkosten</li>
              <li>Kostenloses Beratungsgespräch vor Ort</li>
            </ul>
            <span class="link-arrow">Tankreinigung im Detail <Icon name="arrow" /></span>
          </div>
        </a>
        <div class="svc__list">
          <ServiceList services={rest} />
          <a href="/leistungen/" class="btn btn--ghost svc__all">Alle Leistungen <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ UNTERNEHMEN ============ -->
  <section class="section section--surface" aria-labelledby="h-betrieb">
    <div class="container">
      <SectionHead num="02" eyebrow="Unser Betrieb" title="Leistung und Qualität im Behälterschutz." split={false} />
      <div class="about">
        <Figure src={imgBaustelle} alt="Baustelle mit Bagger und zwei Erdtanks in der Baugrube" caption="Erdtanks in der Baugrube, Neubauprojekt" num="Fig. 01" ratio="4 / 3" class="about__img" />
        <div class="about__text">
          <p class="lead reveal">Seit vielen Jahren steht unser Betrieb für Leistung und Qualität im Bereich Behälterschutz. Mit den sich wandelnden Anforderungen, vor allem in der Umwelttechnik, haben wir unser Leistungsspektrum kontinuierlich erweitert.</p>
          <p class="about__p reveal" style="--d:80ms">Unsere langjährige Erfahrung und Fachkompetenz versetzt uns in die Lage, Sie jederzeit umfassend zu Ihrem Vorhaben zu beraten. Als Fachbetrieb legen wir großen Wert auf die Aus- und Weiterbildung unserer Mitarbeiter, damit wir Ihnen stets die aktuellste Technik für Ihre Installationen empfehlen können.</p>
          <dl class="about__facts reveal" style="--d:160ms">
            <div><dt>Betrieb</dt><dd>Seit vielen Jahren im Behälterschutz</dd></div>
            <div><dt>Qualifikation</dt><dd>TÜV-geprüftes Unternehmen</dd></div>
            <div><dt>Ausrüstung</dt><dd>GGVS-Montage-LKW, Tankschutz-Fachkräfte</dd></div>
          </dl>
          <a href="/unser-betrieb/" class="link-arrow reveal" style="--d:220ms">Mehr über unseren Betrieb <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FACHWISSEN ============ -->
  <section class="section know" aria-labelledby="h-know">
    <div class="container">
      <SectionHead num="03" eyebrow="Fachwissen" title="Warum regelmäßiger Tankschutz so wichtig ist." lead="Von außen lässt sich das Innere eines Tanks nicht beurteilen. Was sich am Tankboden abspielt und welche Folgen das haben kann, zeigen unsere Erfahrungen aus der Praxis." />

      <div class="know__layout">
        <ol class="proc">
          <li class="proc__step reveal">
            <span class="proc__num">01</span>
            <div class="proc__body">
              <h3>Sedimente lagern sich ab</h3>
              <p>Durch die Alterung des Heizöls entstehen Sedimente, die sich am Tankboden ablagern. In Verbindung mit Kondenswasser, Schwitzwasser und Schwefel aus dem Heizöl bildet sich dort eine Sumpfphase.</p>
            </div>
          </li>
          <li class="proc__step reveal" style="--d:60ms">
            <span class="proc__num">02</span>
            <div class="proc__body">
              <h3>Korrosion und Versprödung</h3>
              <p>Bei Stahltanks führt die Sumpfphase zu Lochfraß- und Flächenkorrosion. Bei Kunststofftanks wandern die Weichmacher aus: Der Kunststoff wird hart und spröde, verformt sich und kann reißen.</p>
            </div>
          </li>
          <li class="proc__step reveal" style="--d:120ms">
            <span class="proc__num">03</span>
            <div class="proc__body">
              <h3>Störungen an der Heizung</h3>
              <p>Wird der Ölschlamm angesaugt, führt das zu Störungen oder Defekten an der Heizungsanlage. Im schlimmsten Fall läuft Heizöl aus dem durchkorrodierten Tankboden aus.</p>
            </div>
          </li>
          <li class="proc__step reveal" style="--d:180ms">
            <span class="proc__num">04</span>
            <div class="proc__body">
              <h3>Reinigung stoppt den Prozess</h3>
              <p>Eine sorgfältige Tankreinigung entfernt den aggressiven Schlamm. Der Korrosionsvorgang ist gestoppt, und der Zustand des Tanks kann von innen beurteilt werden.</p>
            </div>
          </li>
        </ol>

        <div class="know__media">
          <Figure src={imgMonteur} alt="Monteur von Tank Service Batho bei der manuellen Reinigung im Inneren eines Tanks" caption="Manuelle Reinigung im Tank" num="Fig. 02" ratio="4 / 3" widths={[300, 600]} sizes="(min-width: 900px) 40vw, 100vw" />
          <Figure src={imgDom} alt="Blick in einen geöffneten Domschacht mit Absaugschlauch" caption="Geöffneter Domschacht mit Absaugung" num="Fig. 03" ratio="4 / 3" class="know__media-2" />
        </div>
      </div>

      <div class="hints">
        <div class="hint reveal">
          <span class="hint__k"><span class="num">Rechtlicher Hinweis</span><strong>§ 22 WHG</strong></span>
          <p>Nach § 22 des Wasserhaushaltsgesetzes haften Halter von Öltanks für alle Veränderungen der Beschaffenheit des Grundwassers in vollem Umfang.</p>
        </div>
        <div class="hint reveal" style="--d:80ms">
          <span class="hint__k"><span class="num">Empfehlung</span><strong>Spätestens alle 5 Jahre</strong></span>
          <p>Jeder Heizöltank sollte spätestens alle 5 Jahre gereinigt und untersucht werden. Eine Tankreinigung ist Bestandteil Ihrer Betreiberpflicht.</p>
        </div>
        <div class="hint reveal" style="--d:160ms">
          <span class="hint__k"><span class="num">Begünstigende Faktoren</span><strong>Ölschlammbildung</strong></span>
          <ul class="hint__list">
            <li>Lichteinfall</li><li>Wärme</li><li>Kondenswasser</li><li>Pilz- oder Bakterienbefall</li><li>Buntmetalle im Tank</li><li>Sauerstoffeintrag ins Öl</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ANSPRECHPARTNER ============ -->
  <section class="section section--surface" aria-labelledby="h-team">
    <div class="container">
      <SectionHead num="04" eyebrow="Ihr Ansprechpartner" title="Persönlich beraten, fachlich auf dem neuesten Stand." lead="Als langjähriger Fachbetrieb legen wir großen Wert auf die Aus- und Weiterbildung unserer Mitarbeiter. Ihr Ansprechpartner berät Sie persönlich zu Ihrem Vorhaben." />
      <div class="person reveal">
        <div class="person__photo"><Image src={imgSebastian} alt="Sebastian Batho, Geschäftsführer von Tank Service Batho" width={118} height={157} /></div>
        <div class="person__body">
          <span class="num">Geschäftsführer</span>
          <h3>{site.ceo}</h3>
          <p class="person__p">Rufen Sie einfach an oder schreiben Sie uns. Wir beraten Sie gerne umfassend zu Ihrem Vorhaben.</p>
        </div>
        <ul class="person__contact">
          <li><span class="fact__label">Telefon</span><a href={site.phoneHref}>{site.phone}</a></li>
          <li><span class="fact__label">E-Mail</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><span class="fact__label">Adresse</span><span>{site.street}, {site.zip} {site.city}</span></li>
        </ul>
      </div>
    </div>
  </section>

  <ContactCta />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; overflow: hidden; background: var(--c-navy-900); color: #fff; }
  .hero__bg { position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
    background-size: 72px 72px; mask-image: linear-gradient(to right, #000 0%, transparent 60%); -webkit-mask-image: linear-gradient(to right, #000 0%, transparent 60%); }
  .hero__grid { position: relative; display: grid; gap: var(--s-7); padding-block: var(--s-7) 0; }
  .hero__text { display: grid; gap: 1.5rem; align-content: center; }
  .hero__title { font-size: clamp(2.5rem, 1.2rem + 5vw, 5.25rem); max-width: 13ch; color: #fff; }
  .hero__lead { font-size: var(--fs-lg); line-height: 1.6; max-width: 48ch; color: rgba(255,255,255,.74); text-wrap: pretty; }
  .hero .btn :global(svg) { width: 18px; height: 18px; }
  .hero__ruler { display: grid; gap: .6rem; margin-top: 1rem; color: rgba(255,255,255,.7); max-width: 520px; }
  .hero__ruler-l { font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.4); line-height: 1.6; }

  .hero__media { position: relative; display: grid; gap: 6px; margin-inline: calc(var(--gutter) * -1); }
  .hero__frame { position: relative; aspect-ratio: 2.2 / 1; overflow: hidden; background: var(--c-navy-800); color: rgba(255,255,255,.75); }
  .hero__frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 55% 50%; }
  .hero__frame::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to right, rgba(11,26,51,.35), transparent 30%); pointer-events: none; }
  .hero__frame .ticks { margin: 12px; z-index: 1; }
  .hero__mark { position: absolute; z-index: 1; font-size: .62rem; letter-spacing: .16em; text-transform: uppercase; color: rgba(255,255,255,.7); }
  .hero__mark--t { top: 12px; left: 50%; transform: translateX(-50%); }
  .hero__sub { display: grid; grid-template-columns: 3fr 2fr; gap: 6px; }
  .hero__frame--2 { aspect-ratio: auto; }
  .hero__frame--2::after { display: none; }
  .hero__spec { display: grid; align-content: end; gap: .6rem; padding: 1.25rem; background: var(--c-navy-800); border-left: 3px solid var(--warm); }
  .hero__spec-v { font-family: var(--f-display); font-weight: 600; font-size: .95rem; line-height: 1.3; }
  .hero__spec-dl { display: grid; gap: .4rem; margin: 0; padding-top: .6rem; border-top: 1px solid rgba(255,255,255,.14); }
  .hero__spec-dl div { display: grid; gap: .1rem; }
  .hero__spec-dl dt { font-family: var(--f-mono); font-size: .58rem; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.5); }
  .hero__spec-dl dd { margin: 0; font-size: var(--fs-sm); font-weight: 500; }
  .hero__spec-dl a:hover { color: var(--warm); }

  @media (min-width: 1024px) {
    .hero__grid { grid-template-columns: minmax(0, 46fr) minmax(0, 54fr); gap: var(--s-8); padding-block: var(--s-8) var(--s-8); align-items: center; }
    .hero__text { padding-right: var(--s-6); }
    .hero__media { margin: 0; margin-right: calc(var(--gutter) * -1); }
    .hero__sub { grid-template-columns: 1fr 1fr; }
    .hero__frame--2 { aspect-ratio: 4 / 3; }
  }

  /* ---------- Vertrauensleiste ---------- */
  .trust { padding-block: 0; background: var(--bg); border-bottom: 1px solid var(--line); }
  .trust :global(.factbar) { border-top: 0; border-bottom: 0; }

  /* ---------- Leistungen ---------- */
  .svc { display: grid; gap: var(--s-7); }
  .svc__feat { display: grid; gap: 0; background: var(--c-navy-900); color: #fff; }
  .svc__feat-img { position: relative; aspect-ratio: 16 / 10; overflow: hidden; color: rgba(255,255,255,.7); }
  .svc__feat-img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--ease); }
  .svc__feat:hover .svc__feat-img :global(img) { transform: scale(1.03); }
  .svc__feat-img .ticks { margin: 12px; }
  .svc__feat-body { display: grid; gap: 1rem; padding: 2rem; align-content: start; }
  .svc__feat-body .num { color: var(--warm); }
  .svc__feat-body h3 { color: #fff; font-size: var(--fs-h3); }
  .svc__feat-body p { color: rgba(255,255,255,.7); font-size: var(--fs-sm); line-height: 1.6; }
  .svc__feat-facts { display: grid; gap: .5rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,.14); font-size: var(--fs-sm); }
  .svc__feat-facts li { display: flex; gap: .6rem; }
  .svc__feat-facts li::before { content: ''; flex: none; width: 6px; height: 6px; margin-top: .55rem; background: var(--warm); }
  .svc__feat .link-arrow { color: #fff; margin-top: .5rem; }
  .svc__list { display: grid; gap: 1.5rem; align-content: start; }
  .svc__all { justify-self: start; }
  .svc__all :global(svg) { width: 16px; height: 16px; }
  @media (min-width: 900px) { .svc { grid-template-columns: 1fr 1.15fr; gap: var(--s-8); align-items: start; } .svc__feat { position: sticky; top: calc(var(--header-h) + 1.5rem); } }

  /* ---------- Unternehmen ---------- */
  .about { display: grid; gap: var(--s-7); }
  .about__text { display: grid; gap: 1.25rem; align-content: center; }
  .about__p { color: var(--c-ink-2); text-wrap: pretty; }
  .about__facts { display: grid; margin: .5rem 0; border-top: 1px solid var(--line); }
  .about__facts > div { display: grid; grid-template-columns: 120px 1fr; gap: 1rem; padding: .8rem 0; border-bottom: 1px solid var(--line); font-size: var(--fs-sm); }
  .about__facts dt { font-family: var(--f-mono); font-size: var(--fs-xs); letter-spacing: .12em; text-transform: uppercase; color: var(--warm-strong); padding-top: .15rem; }
  .about__facts dd { margin: 0; font-weight: 500; color: var(--c-navy-900); }
  @media (min-width: 900px) { .about { grid-template-columns: 1fr 1fr; gap: var(--s-9); align-items: center; } }

  /* ---------- Fachwissen ---------- */
  .know__layout { display: grid; gap: var(--s-8); margin-bottom: var(--s-8); }
  .proc { position: relative; display: grid; padding-left: 0; }
  .proc::before { content: ''; position: absolute; left: 1.05rem; top: 1.5rem; bottom: 1.5rem; width: 1px; background: var(--line); }
  .proc__step { position: relative; display: grid; grid-template-columns: 2.2rem 1fr; gap: 1.25rem; padding: 1.5rem 0; }
  .proc__num { position: relative; z-index: 1; width: 2.2rem; height: 2.2rem; display: grid; place-items: center; border: 1px solid var(--c-navy-900); background: var(--bg); font-family: var(--f-mono); font-size: var(--fs-xs); font-weight: 500; color: var(--c-navy-900); }
  .proc__step:last-child .proc__num { background: var(--c-navy-900); color: #fff; }
  .proc__body { display: grid; gap: .5rem; padding-top: .35rem; }
  .proc__body h3 { font-size: var(--fs-xl); }
  .proc__body p { color: var(--c-ink-2); text-wrap: pretty; max-width: 52ch; }
  .know__media { display: grid; gap: var(--s-5); align-content: start; }
  .know__media-2 { margin-left: 15%; }
  @media (min-width: 900px) { .know__layout { grid-template-columns: 1.1fr 1fr; gap: var(--s-9); } .know__media { position: sticky; top: calc(var(--header-h) + 1.5rem); } }

  .hints { display: grid; gap: 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .hint { display: grid; gap: .9rem; padding: 1.75rem 0; border-bottom: 1px solid var(--line); }
  .hint:last-child { border-bottom: 0; }
  .hint__k { display: grid; gap: .3rem; }
  .hint__k strong { font-family: var(--f-display); font-weight: 700; font-size: var(--fs-lg); letter-spacing: -0.01em; color: var(--c-navy-900); }
  .hint p { font-size: var(--fs-sm); color: var(--c-ink-2); line-height: 1.6; max-width: 40ch; }
  .hint__list { display: flex; flex-wrap: wrap; gap: .4rem; }
  .hint__list li { font-size: var(--fs-xs); padding: .3rem .6rem; border: 1px solid var(--line); color: var(--c-ink-2); }
  @media (min-width: 900px) { .hints { grid-template-columns: repeat(3, 1fr); } .hint { border-bottom: 0; border-right: 1px solid var(--line); padding: 2rem 1.75rem 2rem 0; } .hint + .hint { padding-left: 1.75rem; } .hint:last-child { border-right: 0; } }

  /* ---------- Ansprechpartner ---------- */
  .person { display: grid; gap: 1.5rem; padding: 2rem; background: var(--c-white); border: 1px solid var(--line); }
  .person__photo { width: 118px; overflow: hidden; background: var(--c-surface-2); }
  .person__body { display: grid; gap: .5rem; align-content: start; }
  .person__body h3 { font-size: var(--fs-h3); }
  .person__p { font-size: var(--fs-sm); color: var(--c-ink-2); max-width: 40ch; }
  .person__contact { display: grid; gap: .8rem; align-content: start; border-top: 1px solid var(--line); padding-top: 1rem; }
  .person__contact li { display: grid; gap: .1rem; font-family: var(--f-display); font-weight: 600; word-break: break-word; }
  .person__contact a:hover { color: var(--warm-strong); }
  @media (min-width: 900px) { .person { grid-template-columns: auto 1fr 1fr; gap: 2.5rem; padding: 2.5rem; } .person__contact { border-top: 0; border-left: 1px solid var(--line); padding: 0 0 0 2.5rem; } }
</style>
