  <PageHero eyebrow="Fehler 404" title="Diese Seite gibt es nicht." lead="Die aufgerufene Adresse existiert nicht oder wurde verschoben.">
    <div slot="actions" class="btn-row reveal" style="--d:240ms"><a href="/" class="btn btn--light">Zur Startseite <Icon name="arrow" /></a><a href="/leistungen/" class="btn btn--outline-light">Zu den Leistungen</a></div>
  </PageHero>
</Base>
