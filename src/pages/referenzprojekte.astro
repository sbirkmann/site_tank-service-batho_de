---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactCta from '../components/ContactCta.astro';
import imgA from '../assets/img/referenz-handtuchhalter.jpg';
import imgB from '../assets/img/referenz-heizung.jpg';
import imgC from '../assets/img/referenz-thermostat.jpg';
import imgBaustelle from '../assets/img/baustelle-erdtanks.jpg';
import imgMonteur from '../assets/img/monteur-im-tank.jpg';
import imgDom from '../assets/img/domschacht-absaugung.jpg';
import imgSchlamm from '../assets/img/oelschlamm-tankboden.jpg';
const refs = [
  { img: imgA, alt: 'Handtuchhalter – Referenzprojekt' },
  { img: imgB, alt: 'Heizung mit Stufenanzeige – Referenzprojekt' },
  { img: imgC, alt: 'Thermostat – Referenzprojekt' },
];
const work = [
  { img: imgBaustelle, alt: 'Erdtanks in der Baugrube mit Bagger', cap: 'Erdtanks auf der Baustelle' },
  { img: imgMonteur, alt: 'Monteur im Inneren eines Tanks', cap: 'Manuelle Reinigung im Tank' },
  { img: imgDom, alt: 'Geöffneter Domschacht mit Absaugschlauch', cap: 'Geöffneter Domschacht' },
  { img: imgSchlamm, alt: 'Ölschlamm am Boden eines Heizöltanks', cap: 'Ölschlamm am Tankboden' },
];
---
<Base title="Referenzprojekte" description="Referenzprojekte und Einblicke in die Arbeit von Tank Service Batho aus Ubstadt-Weiher.">
  <PageHero eyebrow="Referenzprojekte" title="Einblicke in unsere Arbeit." lead="Hier finden Sie einige Referenzprojekte der Firma Tank Service Batho sowie Eindrücke von unseren Einsätzen." crumbs={[{ label: 'Referenzprojekte' }]} />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow reveal">Aus der Praxis</span>
        <h2 class="reveal" style="--d:80ms">Einsätze an der Tankanlage</h2>
      </div>
      <div class="gal">
        {work.map((w, i) => (
          <figure class:list={['img-frame reveal', { 'gal__wide': i === 0 }]} style={`--d:${i * 80}ms`}>
            <Image src={w.img} alt={w.alt} widths={[400, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" />
            <figcaption class="img-frame__cap">{w.cap}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow reveal">Referenzprojekte</span>
        <h2 class="reveal" style="--d:80ms">Referenzen</h2>
      </div>
      <div class="gal gal--3">
        {refs.map((r, i) => (
          <figure class="img-frame reveal" style={`--d:${i * 80}ms`}>
            <Image src={r.img} alt={r.alt} widths={[400, 800]} sizes="(min-width: 900px) 33vw, 100vw" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <ContactCta />
</Base>
<style>
  .gal { display: grid; gap: var(--s-4); }
  .gal .img-frame { aspect-ratio: 4 / 3; }
  @media (min-width: 720px) { .gal { grid-template-columns: 1fr 1fr; } .gal__wide { grid-column: 1 / -1; aspect-ratio: 21 / 9; } .gal--3 { grid-template-columns: repeat(3, 1fr); } }
</style>
