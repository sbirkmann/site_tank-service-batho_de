---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ContactCta from '../../components/ContactCta.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/services';
import imgSchlamm from '../../assets/img/oelschlamm-tankboden.jpg';
import imgMonteur from '../../assets/img/monteur-im-tank.jpg';
import imgDom from '../../assets/img/domschacht-absaugung.jpg';
---
<Base title="Leistungen" description="Unser Leistungsspektrum: Tankreinigung, Beschichtungen, Anodenschutz, Innenhülle / Leckschutzauskleidung, Beseitigung von Ölschäden, Stilllegung, Tankdemontage und Neutankanlagen.">
  <PageHero eyebrow="Leistungen" title="Ein großes Leistungsspektrum rund um Ihre Tankanlage." lead="Bei der Planung, Installation und Modernisierung Ihrer Tankanlage unterstützen wir Sie gerne. Am Anfang all unserer Projekte steht die Besichtigung Ihrer Räumlichkeiten und ein umfassendes Beratungsgespräch." crumbs={[{ label: 'Leistungen' }]} />

  <section class="section">
    <div class="container">
      <div class="grid grid-4">
        {services.map((s, i) => <ServiceCard service={s} delay={i * 60} />)}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container approach">
      <div class="approach__text">
        <span class="eyebrow reveal">Unsere Arbeitsweise</span>
        <h2 class="reveal" style="--d:80ms">Die Lösung, die zu Ihren Ansprüchen und Ihrem Kostenrahmen passt.</h2>
        <p class="lead reveal" style="--d:160ms">Wir stellen die Lösung zusammen, die genau zu Ihren Ansprüchen und Ihrem Kostenrahmen passt. Legen Sie die Arbeit in unsere Hände: Wir sorgen dafür, dass während der Baumaßnahmen so wenig Unannehmlichkeiten wie möglich entstehen.</p>
        <ol class="approach__steps reveal" style="--d:220ms">
          <li><span class="mono">01</span><div><strong>Besichtigung vor Ort</strong><p>Wir sehen uns Ihre Räumlichkeiten und Ihre Tankanlage an.</p></div></li>
          <li><span class="mono">02</span><div><strong>Umfassendes Beratungsgespräch</strong><p>Wir beraten Sie zu Ihrem Vorhaben und den passenden Maßnahmen.</p></div></li>
          <li><span class="mono">03</span><div><strong>Ausführung durch Fachkräfte</strong><p>Unsere Tankschutz-Fachkräfte führen die Arbeiten mit GGVS-Montage-LKW aus.</p></div></li>
        </ol>
        <a href="/kontakt/" class="btn reveal" style="--d:280ms">Beratung anfragen <Icon name="arrow" /></a>
      </div>
      <div class="approach__gallery">
        <figure class="img-frame reveal"><Image src={imgSchlamm} alt="Ölschlamm und Rückstände am Boden eines Heizöltanks" widths={[400, 800]} sizes="(min-width: 900px) 40vw, 100vw" /><figcaption class="img-frame__cap">Ölschlamm am Tankboden</figcaption></figure>
        <figure class="img-frame reveal" style="--d:100ms"><Image src={imgMonteur} alt="Monteur von Tank Service Batho im Inneren eines Tanks" widths={[300, 600]} sizes="(min-width: 900px) 20vw, 50vw" /><figcaption class="img-frame__cap">Im Tank</figcaption></figure>
        <figure class="img-frame reveal" style="--d:160ms"><Image src={imgDom} alt="Blick in einen geöffneten Domschacht mit Absaugschlauch" widths={[400, 800]} sizes="(min-width: 900px) 20vw, 50vw" /><figcaption class="img-frame__cap">Domschacht</figcaption></figure>
      </div>
    </div>
  </section>

  <ContactCta />
</Base>
<style>
  .approach { display: grid; gap: var(--s-8); }
  .approach__text { display: grid; gap: 1.25rem; align-content: start; }
  .approach__text h2 { max-width: 18ch; }
  .approach__steps { display: grid; gap: 1rem; margin: 1rem 0; }
  .approach__steps li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; padding: 1rem 1.25rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); }
  .approach__steps .mono { color: var(--accent); padding-top: .15rem; }
  .approach__steps strong { font-family: var(--f-display); display: block; margin-bottom: .2rem; }
  .approach__steps p { font-size: var(--fs-sm); color: var(--muted); }
  .approach .btn { justify-self: start; }
  .approach .btn :global(svg) { width: 18px; height: 18px; }
  .approach__gallery { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); align-content: start; }
  .approach__gallery .img-frame { aspect-ratio: 4 / 3; }
  .approach__gallery .img-frame:first-child { grid-column: 1 / -1; }
  @media (min-width: 900px) { .approach { grid-template-columns: 1.1fr 1fr; gap: var(--s-9); } }
</style>
