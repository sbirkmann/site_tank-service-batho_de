---
/**
 * Bildmarke: vektorisierte Rekonstruktion des blauen „TS“-Tank-Emblems,
 * das auf dem Fahrzeugfoto der bestehenden Website zu sehen ist.
 */
interface Props { light?: boolean; class?: string; size?: number }
const { light = false, class: cls = '', size = 40 } = Astro.props;
---
<a href="/" class:list={['logo', cls, { 'logo--light': light }]} aria-label="Tank Service Batho – Startseite">
  <svg class="logo__mark" width={size} height={size} viewBox="0 0 64 72" aria-hidden="true" focusable="false">
    <!-- Tank-Silhouette mit Domstutzen -->
    <path fill="currentColor" d="M25 3h14a2 2 0 0 1 2 2v3h4.5a1.5 1.5 0 0 1 0 3H43v3.6C54 17.6 61.5 28 61.5 40.5 61.5 57 48.8 70 32 70S2.5 57 2.5 40.5C2.5 28 10 17.6 21 14.6V11h-2.5a1.5 1.5 0 0 1 0-3H23V5a2 2 0 0 1 2-2z"/>
    <circle cx="32" cy="42" r="22.5" fill="var(--logo-bg, #fff)"/>
    <circle cx="32" cy="42" r="19" fill="currentColor"/>
    <text x="32" y="50.5" text-anchor="middle" font-family="Archivo, Inter, sans-serif" font-weight="800" font-size="23" letter-spacing="-1.5" fill="var(--logo-bg, #fff)">TS</text>
  </svg>
  <span class="logo__word">
    <span class="logo__name">Tank Service Batho</span>
    <span class="logo__sub">Tankschutz · Ubstadt-Weiher</span>
  </span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: .8rem; color: var(--c-navy-800); --logo-bg: #fff; }
  .logo--light { color: #fff; --logo-bg: var(--c-navy-900); }
  .logo__mark { flex: none; }
  .logo__word { display: grid; line-height: 1.05; }
  .logo__name { font-family: var(--f-display); font-weight: 800; font-size: 1.05rem; letter-spacing: -0.02em; white-space: nowrap; }
  .logo__sub { font-family: var(--f-mono); font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; opacity: .65; margin-top: .2rem; white-space: nowrap; }
  @media (max-width: 420px) { .logo__sub { display: none; } }
</style>
