---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { services } from '../data/services';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__top">
    <div class="footer__brand">
      <Logo light size={44} />
      <p class="footer__claim">Qualifizierter, TÜV-geprüfter Fachbetrieb für Tankreinigung, Tankschutz, Demontage und Neutankanlagen aus Ubstadt-Weiher.</p>
    </div>
    <div class="footer__col">
      <h3 class="footer__h">Leistungen</h3>
      <ul class="footer__list">
        {services.map((s) => <li><a href={`/leistungen/${s.slug}/`}>{s.short}</a></li>)}
      </ul>
    </div>
    <div class="footer__col">
      <h3 class="footer__h">Unternehmen</h3>
      <ul class="footer__list">
        <li><a href="/unser-betrieb/">Unser Betrieb</a></li>
        <li><a href="/referenzprojekte/">Referenzprojekte</a></li>
        <li><a href="/kontakt/">Kontakt &amp; Anfahrt</a></li>
        <li><a href="/impressum/">Impressum</a></li>
        <li><a href="/agb/">Allgemeine Geschäftsbedingungen</a></li>
      </ul>
    </div>
    <div class="footer__col">
      <h3 class="footer__h">Kontakt</h3>
      <address class="footer__addr">
        <span>{site.name}</span>
        <span>{site.street}</span>
        <span>{site.zip} {site.city}</span>
      </address>
      <ul class="footer__list footer__list--contact">
        <li><a href={site.phoneHref}><Icon name="phone" /> {site.phone}</a></li>
        <li><span><Icon name="fax" /> Fax {site.fax}</span></li>
        <li><a href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer__bottom">
    <span>© {year} {site.name}</span>
    <span class="mono footer__coords">{site.street} · {site.zip} {site.city}</span>
  </div>
</footer>
<style>
  .footer { background: var(--c-navy-900); color: rgba(255,255,255,.78); position: relative; overflow: hidden; }
  .footer::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px); background-size: 64px 64px; mask-image: linear-gradient(to bottom, transparent, #000 60%); -webkit-mask-image: linear-gradient(to bottom, transparent, #000 60%); pointer-events: none; }
  .footer__top { position: relative; display: grid; gap: var(--s-7); padding-block: var(--s-9) var(--s-7); }
  .footer__brand { display: grid; gap: 1.25rem; align-content: start; }
  .footer__claim { max-width: 34ch; font-size: var(--fs-sm); line-height: 1.6; color: rgba(255,255,255,.6); }
  .footer__h { font-family: var(--f-mono); font-size: var(--fs-xs); font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--warm); margin-bottom: 1.1rem; }
  .footer__list { display: grid; gap: .55rem; font-size: var(--fs-sm); }
  .footer__list a { transition: color .2s; }
  .footer__list a:hover { color: #fff; }
  .footer__list--contact a, .footer__list--contact span { display: inline-flex; gap: .6rem; align-items: center; }
  .footer__list--contact :global(svg) { width: 16px; height: 16px; color: var(--warm); flex: none; }
  .footer__addr { font-style: normal; display: grid; font-size: var(--fs-sm); margin-bottom: 1rem; color: #fff; }
  .footer__bottom { position: relative; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding-block: 1.5rem; border-top: 1px solid rgba(255,255,255,.1); font-size: var(--fs-xs); color: rgba(255,255,255,.5); }
  .footer__coords { letter-spacing: .06em; }
  @media (min-width: 720px) { .footer__top { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .footer__top { grid-template-columns: 1.4fr 1fr 1fr 1.2fr; } }
</style>
