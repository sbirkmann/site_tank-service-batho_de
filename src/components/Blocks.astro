---
import Icon from './Icon.astro';
import type { Block } from '../data/services';
interface Props { blocks: Block[] }
const { blocks } = Astro.props;
---
<div class="blocks">
  {blocks.map((b, i) => {
    const d = `--d:${Math.min(i, 3) * 60}ms`;
    if (b.type === 'text') return (
      <section class="blk reveal" style={d}>
        {b.heading && <h2 class="blk__h">{b.heading}</h2>}
        <div class="blk__prose">{b.paragraphs.map((p) => <p>{p}</p>)}</div>
      </section>
    );
    if (b.type === 'note') return (
      <aside class="blk blk--note reveal" style={d}>
        <span class="blk--note__mark"><Icon name="check" /></span>
        <p>{b.text}</p>
      </aside>
    );
    if (b.type === 'list') return (
      <section class="blk reveal" style={d}>
        {b.heading && <h2 class="blk__h">{b.heading}</h2>}
        {b.intro && <p class="blk__intro">{b.intro}</p>}
        <ul class="checklist">{b.items.map((it) => <li><Icon name="check" /><span>{it}</span></li>)}</ul>
      </section>
    );
    if (b.type === 'options') return (
      <section class="blk reveal" style={d}>
        {b.heading && <h2 class="blk__h">{b.heading}</h2>}
        {b.intro && <p class="blk__intro">{b.intro}</p>}
        <ul class="options">{b.items.map((it, k) => <li><span class="options__k">{String.fromCharCode(65 + k)}</span><span>{it}</span></li>)}</ul>
      </section>
    );
    return (
      <section class="blk reveal" style={d}>
        {b.heading && <h2 class="blk__h">{b.heading}</h2>}
        {b.intro && <p class="blk__intro">{b.intro}</p>}
        <ol class="steps">{b.items.map((it, k) => <li class="steps__item"><span class="steps__num">{String(k + 1).padStart(2, '0')}</span><p>{it}</p></li>)}</ol>
      </section>
    );
  })}
</div>
<style>
  .blocks { display: grid; gap: clamp(3rem, 5vw, 4.5rem); }
  .blk__h { font-size: var(--fs-xl); margin-bottom: 1.1rem; }
  .blk__prose p, .blk__intro { color: var(--c-ink-2); text-wrap: pretty; }
  .blk__intro { margin-bottom: 1.25rem; }
  .blk--note { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; padding: 1.5rem; border-left: 3px solid var(--accent); background: var(--c-surface); border-radius: 0 var(--radius-lg) var(--radius-lg) 0; font-family: var(--f-display); font-weight: 600; font-size: var(--fs-lg); line-height: 1.4; color: var(--c-navy-900); }
  .blk--note__mark { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; background: var(--c-navy-800); color: #fff; }
  .blk--note__mark :global(svg) { width: 16px; height: 16px; }
  .checklist { display: grid; gap: .7rem; }
  .checklist li { display: grid; grid-template-columns: auto 1fr; gap: .8rem; align-items: start; padding: .9rem 1rem; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; color: var(--c-ink-2); }
  .checklist :global(svg) { width: 18px; height: 18px; color: var(--accent); margin-top: .2rem; }
  @media (min-width: 720px) { .checklist { grid-template-columns: 1fr 1fr; } }
  .options { display: grid; gap: .75rem; }
  .options li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: center; padding: 1rem 1.25rem; border: 1px solid var(--line); border-radius: var(--radius); color: var(--c-ink-2); }
  .options__k { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--c-navy-800); font-family: var(--f-mono); font-weight: 500; color: var(--c-navy-800); }
  .steps { display: grid; counter-reset: s; }
  .steps__item { position: relative; display: grid; grid-template-columns: 3.25rem 1fr; gap: .5rem 1rem; padding: 1.1rem 0; border-top: 1px solid var(--line); }
  .steps__item:last-child { border-bottom: 1px solid var(--line); }
  .steps__num { font-family: var(--f-mono); font-weight: 500; color: var(--accent); padding-top: .15rem; }
  .steps__item p { color: var(--c-ink-2); text-wrap: pretty; }
  .steps__item::after { content: ''; position: absolute; left: 0; bottom: -1px; height: 1px; width: 0; background: var(--accent); transition: width .5s var(--ease); }
  .steps__item:hover::after { width: 100%; }
</style>
