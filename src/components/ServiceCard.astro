---
import Icon from './Icon.astro';
import type { Service } from '../data/services';
interface Props { service: Service; delay?: number }
const { service: s, delay = 0 } = Astro.props;
---
<a href={`/leistungen/${s.slug}/`} class="scard card reveal" style={`--d:${delay}ms`}>
  <div class="scard__top">
    <span class="scard__idx">{s.index}</span>
    <span class="scard__arrow"><Icon name="arrow" /></span>
  </div>
  <h3 class="scard__title">{s.short}</h3>
  <p class="scard__teaser">{s.teaser}</p>
  <span class="scard__line" aria-hidden="true"></span>
</a>
<style>
  .scard { padding: 1.75rem; min-height: 240px; gap: .75rem; color: inherit; }
  .scard__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: auto; }
  .scard__idx { font-family: var(--f-mono); font-size: var(--fs-sm); color: var(--accent); letter-spacing: .08em; }
  .scard__arrow { width: 40px; height: 40px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--c-navy-800); transition: background .3s var(--ease), color .3s var(--ease), border-color .3s var(--ease), transform .3s var(--ease); }
  .scard__arrow :global(svg) { width: 18px; height: 18px; }
  .scard:hover .scard__arrow { background: var(--c-navy-800); border-color: var(--c-navy-800); color: #fff; transform: rotate(-45deg); }
  .scard__title { font-size: 1.25rem; margin-top: 2.5rem; }
  .scard__teaser { font-size: var(--fs-sm); color: var(--muted); line-height: 1.55; }
  .scard__line { position: absolute; left: 0; bottom: 0; height: 3px; width: 0; background: var(--accent); transition: width .5s var(--ease); }
  .scard:hover .scard__line { width: 100%; }
</style>
