---
/** Kopfbereich für Unterseiten */
import Icon from './Icon.astro';
interface Props { eyebrow?: string; title: string; lead?: string; crumbs?: { label: string; href?: string }[]; index?: string }
const { eyebrow, title, lead, crumbs = [], index } = Astro.props;
---
<section class="phero section--dark">
  <div class="tech-grid" aria-hidden="true"></div>
  <div class="container phero__inner">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Brotkrumen">
        <ol>
          <li><a href="/">Start</a></li>
          {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
        </ol>
      </nav>
    )}
    <div class="phero__grid">
      <div class="phero__text">
        {eyebrow && <span class="eyebrow reveal">{eyebrow}</span>}
        <h1 class="reveal" style="--d:80ms">{title}</h1>
        {lead && <p class="lead reveal" style="--d:160ms">{lead}</p>}
        <slot name="actions" />
      </div>
      {index && <span class="phero__index reveal reveal--fade" aria-hidden="true" style="--d:240ms">{index}</span>}
    </div>
  </div>
</section>
<style>
  .phero { position: relative; overflow: hidden; padding: calc(var(--s-6)) 0 var(--s-8); }
  .phero__inner { position: relative; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: .5rem; font-family: var(--f-mono); font-size: var(--fs-xs); letter-spacing: .06em; color: rgba(255,255,255,.55); margin-bottom: var(--s-7); }
  .crumbs li + li::before { content: '/'; margin-right: .5rem; opacity: .5; }
  .crumbs a:hover { color: #fff; }
  .crumbs [aria-current] { color: rgba(255,255,255,.85); }
  .phero__grid { display: grid; gap: var(--s-6); align-items: end; }
  .phero__text { display: grid; gap: 1.25rem; max-width: 780px; }
  .phero__index { font-family: var(--f-display); font-weight: 800; font-size: clamp(5rem, 14vw, 13rem); line-height: .8; letter-spacing: -0.06em; color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,.18); justify-self: end; user-select: none; }
  @media (min-width: 1024px) { .phero { padding-bottom: var(--s-9); } .phero__grid { grid-template-columns: 1fr auto; } }
</style>
