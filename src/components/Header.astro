---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
import { services } from '../data/services';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="header" id="header" data-header>
  <div class="container container--wide header__inner">
    <Logo />
    <nav class="nav" aria-label="Hauptnavigation">
      <ul class="nav__list">
        {nav.map((item) => (
          <li class:list={['nav__item', { 'nav__item--has-sub': item.children }]}>
            <a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
              {item.children && <svg class="nav__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>}
            </a>
            {item.children && (
              <div class="mega" role="group" aria-label="Leistungen">
                <div class="mega__inner">
                  <div class="mega__intro">
                    <span class="eyebrow">Leistungen</span>
                    <p>Alles rund um Ihre Tankanlage: von der Reinigung bis zur Neuanlage.</p>
                    <a href="/leistungen/" class="link-arrow">Alle Leistungen <Icon name="arrow" /></a>
                  </div>
                  <ul class="mega__list">
                    {services.map((s) => (
                      <li>
                        <a href={`/leistungen/${s.slug}/`} class:list={['mega__link', { 'is-active': path.startsWith(`/leistungen/${s.slug}/`) }]}>
                          <span class="mega__idx">{s.index}</span>
                          <span class="mega__txt"><strong>{s.short}</strong><small>{s.teaser}</small></span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="header__actions">
      <a href={site.phoneHref} class="header__phone"><Icon name="phone" /><span>{site.phone}</span></a>
      <a href="/kontakt/" class="btn btn--accent header__cta">Anfrage</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-nav" data-burger>
        <span class="visually-hidden">Menü öffnen</span>
        <span class="burger__bar"></span><span class="burger__bar"></span><span class="burger__bar"></span>
      </button>
    </div>
  </div>

</header>
<div class="mobile" id="mobile-nav" data-mobile hidden>
  <div class="mobile__scroll">
    <ul class="mobile__list">
      {nav.map((item) => (
        <li>
          {item.children ? (
            <details class="mobile__details" open={path.startsWith('/leistungen/')}>
              <summary class="mobile__link">{item.label}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
              <ul class="mobile__sub">
                <li><a href="/leistungen/" class="mobile__sublink"><span class="mono">—</span> Übersicht</a></li>
                {services.map((s) => <li><a href={`/leistungen/${s.slug}/`} class="mobile__sublink"><span class="mono">{s.index}</span> {s.short}</a></li>)}
              </ul>
            </details>
          ) : (
            <a href={item.href} class:list={['mobile__link', { 'is-active': isActive(item.href) }]}>{item.label}</a>
          )}
        </li>
      ))}
    </ul>
    <div class="mobile__contact">
      <a href={site.phoneHref} class="btn btn--light"><Icon name="phone" /> {site.phone}</a>
      <a href={`mailto:${site.email}`} class="btn btn--outline-light"><Icon name="mail" /> E-Mail schreiben</a>
      <p class="mobile__addr">{site.name}<br />{site.street}<br />{site.zip} {site.city}</p>
    </div>
  </div>
</div>


<style>
  .header { position: sticky; top: 0; z-index: 100; background: rgba(250,249,246,.9); backdrop-filter: saturate(180%) blur(14px); -webkit-backdrop-filter: saturate(180%) blur(14px); border-bottom: 1px solid transparent; transition: border-color .3s, box-shadow .3s; }
  .header.is-scrolled { border-bottom-color: var(--line); box-shadow: 0 8px 30px -20px rgba(11,26,51,.3); --header-h: 64px; }
  .header__inner { transition: min-height .3s var(--ease); }
  .header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--s-6); min-height: var(--header-h); }
  .nav { display: none; }
  .nav__list { display: flex; gap: .25rem; }
  .nav__item { position: relative; }
  .nav__link { display: inline-flex; align-items: center; gap: .35rem; padding: .6rem .85rem; font-family: var(--f-display); font-weight: 600; font-size: .95rem; color: var(--c-ink-2); border-radius: var(--radius); transition: color .2s, background .2s; }
  .nav__link::after { content: ''; position: absolute; left: .85rem; right: .85rem; bottom: .3rem; height: 2px; background: var(--warm); transform: scaleX(0); transform-origin: left; transition: transform .3s var(--ease); }
  .nav__link { position: relative; }
  .nav__link:hover { color: var(--c-navy-900); }
  .nav__link.is-active { color: var(--c-navy-900); }
  .nav__link.is-active::after, .nav__link:hover::after { transform: scaleX(1); }
  .nav__chev { width: 14px; height: 14px; transition: transform .3s var(--ease); }
  .nav__item--has-sub:hover .nav__chev, .nav__item--has-sub:focus-within .nav__chev { transform: rotate(180deg); }

  .mega { position: absolute; left: 50%; top: 100%; padding-top: 14px; width: min(860px, calc(100vw - 2rem)); transform: translateX(-50%) translateY(6px); opacity: 0; visibility: hidden; transition: opacity .25s var(--ease), transform .3s var(--ease), visibility 0s .3s; }
  .nav__item--has-sub:hover .mega, .nav__item--has-sub:focus-within .mega { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); transition-delay: 0s; }
  .mega__inner { display: grid; grid-template-columns: 240px 1fr; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: 0 30px 60px -30px rgba(11,26,51,.35); overflow: hidden; }
  .mega__intro { padding: 1.5rem; background: var(--c-surface); display: grid; align-content: start; gap: .9rem; font-size: var(--fs-sm); color: var(--c-ink-2); border-right: 1px solid var(--line); }
  .mega__list { display: grid; grid-template-columns: 1fr 1fr; padding: .75rem; }
  .mega__link { display: grid; grid-template-columns: auto 1fr; gap: .8rem; padding: .7rem .8rem; border-radius: var(--radius); transition: background .2s; }
  .mega__link:hover, .mega__link.is-active { background: var(--c-surface); }
  .mega__idx { font-family: var(--f-mono); font-size: var(--fs-xs); color: var(--warm-strong); padding-top: .25rem; }
  .mega__txt { display: grid; gap: .15rem; }
  .mega__txt strong { font-family: var(--f-display); font-size: .92rem; color: var(--c-navy-900); }
  .mega__txt small { font-size: .78rem; line-height: 1.4; color: var(--muted); }

  .header__actions { display: flex; align-items: center; gap: .75rem; }
  .header__phone { display: none; align-items: center; gap: .5rem; font-family: var(--f-display); font-weight: 600; font-size: .95rem; color: var(--c-navy-900); padding: .5rem .6rem; }
  .header__phone :global(svg) { width: 18px; height: 18px; color: var(--warm-strong); }
  .header__cta { display: none; min-height: 2.75rem; padding: .6rem 1.1rem; font-size: .9rem; }
  .burger { position: relative; width: 44px; height: 44px; display: grid; place-items: center; gap: 0; border: 1px solid var(--line); border-radius: var(--radius); }
  .burger__bar { position: absolute; width: 20px; height: 2px; background: var(--c-navy-900); border-radius: 2px; transition: transform .35s var(--ease), opacity .2s; }
  .burger__bar:nth-child(2) { transform: translateY(-6px); }
  .burger__bar:nth-child(4) { transform: translateY(6px); }
  .burger[aria-expanded="true"] .burger__bar:nth-child(2) { transform: rotate(45deg); }
  .burger[aria-expanded="true"] .burger__bar:nth-child(3) { opacity: 0; }
  .burger[aria-expanded="true"] .burger__bar:nth-child(4) { transform: rotate(-45deg); }

  .mobile { position: fixed; inset: var(--header-h) 0 0 0; z-index: 99; background: var(--c-navy-900); color: #fff; }
  .mobile[hidden] { display: none; }
  .mobile__scroll { height: 100%; overflow-y: auto; padding: 1.5rem var(--gutter) 3rem; display: grid; align-content: space-between; gap: 2rem; }
  .mobile__list { display: grid; }
  .mobile__link { display: flex; justify-content: space-between; align-items: center; padding: 1rem 0; font-family: var(--f-display); font-weight: 700; font-size: 1.5rem; letter-spacing: -0.02em; border-bottom: 1px solid rgba(255,255,255,.1); cursor: pointer; list-style: none; }
  .mobile__link::-webkit-details-marker { display: none; }
  .mobile__link.is-active { color: var(--warm); }
  .mobile__link :global(svg) { width: 22px; height: 22px; transition: transform .3s var(--ease); }
  .mobile__details[open] .mobile__link :global(svg) { transform: rotate(180deg); }
  .mobile__sub { display: grid; padding: .5rem 0 1rem; }
  .mobile__sublink { display: flex; gap: 1rem; padding: .65rem 0; font-size: 1.05rem; color: rgba(255,255,255,.8); }
  .mobile__sublink .mono { color: var(--warm); font-size: var(--fs-xs); padding-top: .3rem; }
  .mobile__contact { display: grid; gap: .75rem; }
  .mobile__addr { font-size: var(--fs-sm); color: rgba(255,255,255,.6); line-height: 1.5; padding-top: .5rem; }
  .mobile__contact .btn :global(svg) { width: 18px; height: 18px; }

  @media (min-width: 640px) { .header__phone { display: inline-flex; } }
  @media (min-width: 1100px) {
    .nav { display: block; }
    .burger, .mobile { display: none !important; }
    .header__cta { display: inline-flex; }
  }
</style>

<script>
  const header = document.querySelector('[data-header]')!;
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]')!;
  const mobile = document.querySelector<HTMLElement>('[data-mobile]')!;
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
  const setOpen = (open: boolean) => {
    burger.setAttribute('aria-expanded', String(open));
    mobile.hidden = !open;
    document.documentElement.style.overflow = open ? 'hidden' : '';
    burger.querySelector('.visually-hidden')!.textContent = open ? 'Menü schließen' : 'Menü öffnen';
  };
  burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !mobile.hidden) setOpen(false); });
  window.matchMedia('(min-width: 1100px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
</script>
