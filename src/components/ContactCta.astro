---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Sie haben Interesse oder Fragen?', text = 'Nehmen Sie am besten direkt Kontakt mit uns auf. Rufen Sie einfach an oder nutzen Sie unser Kontaktformular.' } = Astro.props;
---
<section class="cta section--dark">
  <div class="tech-grid" aria-hidden="true"></div>
  <div class="container cta__inner">
    <div class="cta__text">
      <span class="eyebrow reveal"><span class="num" style="color:var(--warm)">05</span>&nbsp; Kontakt</span>
      <h2 class="reveal" style="--d:80ms">{title}</h2>
      <p class="lead reveal" style="--d:160ms">{text}</p>
      <div class="btn-row reveal" style="--d:240ms">
        <a href={site.phoneHref} class="btn btn--light"><Icon name="phone" /> {site.phone}</a>
        <a href="/kontakt/" class="btn btn--accent">Anfrage stellen <Icon name="arrow" /></a>
      </div>
    </div>
    <div class="cta__facts reveal" style="--d:200ms">
      <div class="fact"><span class="fact__icon"><Icon name="pin" /></span><div><div class="fact__label">Adresse</div><div class="fact__value">{site.street}<br />{site.zip} {site.city}</div></div></div>
      <div class="fact"><span class="fact__icon"><Icon name="mail" /></span><div><div class="fact__label">E-Mail</div><div class="fact__value"><a href={`mailto:${site.email}`}>{site.email}</a></div></div></div>
      <div class="fact"><span class="fact__icon"><Icon name="fax" /></span><div><div class="fact__label">Fax</div><div class="fact__value">{site.fax}</div></div></div>
    </div>
  </div>
</section>
<style>
  .cta { position: relative; overflow: hidden; padding-block: var(--section); }
  .cta__inner { position: relative; display: grid; gap: var(--s-8); }
  .cta__text { display: grid; gap: 1.25rem; }
  .cta__text h2 { max-width: 16ch; }
  .cta__facts { display: grid; gap: 0; align-content: center; border-top: 1px solid rgba(255,255,255,.14); }
  .cta__facts .fact { padding: 1.25rem 0; border-bottom: 1px solid rgba(255,255,255,.1); }
  .cta__facts .fact__icon { border-radius: 0; }
  .cta__facts .fact__value { color: #fff; font-size: var(--fs-md); }
  .cta .btn :global(svg) { width: 18px; height: 18px; }
  @media (min-width: 1024px) { .cta__inner { grid-template-columns: 1.3fr 1fr; align-items: center; } }
</style>
