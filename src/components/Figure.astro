---
/** Bildfläche mit technischer Bildunterschrift (Nummer + Caption) und Eckmarkierungen */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; num?: string; ratio?: string; sizes?: string; widths?: number[]; position?: string; class?: string; eager?: boolean; marks?: boolean }
const { src, alt, caption, num, ratio = '4 / 3', sizes = '(min-width: 900px) 50vw, 100vw', widths = [480, 800, 1200], position = '50% 50%', class: cls = '', eager = false, marks = true } = Astro.props;
---
<figure class:list={['fig reveal', cls]} style={`--ratio:${ratio}; --pos:${position}`}>
  <div class="fig__frame">
    <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
    {marks && <span class="ticks" aria-hidden="true"></span>}
  </div>
  {caption && <figcaption class="fig__cap">{num && <span class="num">{num}</span>}<span>{caption}</span></figcaption>}
</figure>
<style>
  .fig { margin: 0; display: grid; gap: .6rem; }
  .fig__frame { position: relative; aspect-ratio: var(--ratio); overflow: hidden; background: var(--c-navy-900); color: rgba(255,255,255,.7); }
  .fig__frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); transition: transform 1.4s var(--ease); }
  .fig:hover .fig__frame :global(img) { transform: scale(1.03); }
  .fig__frame .ticks { margin: 10px; }
  .fig__cap { display: flex; gap: .75rem; align-items: baseline; font-size: var(--fs-xs); font-family: var(--f-mono); letter-spacing: .04em; color: var(--muted); padding-top: .4rem; border-top: 1px solid var(--line); }
</style>
